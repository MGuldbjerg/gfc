# Kopiér denne fil til .env.local og udfyld værdierne.

# Turso (libSQL) — applikationsdatabase
TURSO_DATABASE_URL=libsql://DIT-DB.turso.io
TURSO_AUTH_TOKEN=dit_turso_token

# Brevo — transaktionsmail (magic links, velkomst, ligabesked) + nyhedsbrevsliste
BREVO_API_KEY=din_brevo_nøgle
BREVO_SENDER_EMAIL=afsender@dit-domæne.dk

# Auth.js
AUTH_SECRET=opfind-en-lang-tilfældig-streng
AUTH_URL=http://localhost:3000
ADMIN_EMAILS=din@mail.dk

# Bruges af GitHub Actions cron (leaderboard-opdatering + dagligt resumé)
CRON_SECRET=opfind-et-langt-hemmeligt-password

# Facebook — automatiske opslag på GFC-SIDEN (grupper kan ikke tilgås via API)
# Hentes i Meta-appen: Side-ID under Om på siden, token via Graph API Explorer
# → byt til langtidsholdbart token (se scripts/facebook-token.mjs).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
