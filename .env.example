# Kopiér denne fil til .env.local og udfyld værdierne
# Hent nøgler fra: https://supabase.com/dashboard → dit projekt → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://DIN_PROJEKT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=din_anon_nøgle
SUPABASE_SERVICE_ROLE_KEY=din_service_role_nøgle

# Bruges af GitHub Actions cron til at cache data i Supabase
CRON_SECRET=opfind-et-langt-hemmeligt-password
